    "sharp": "^0.34.5"
  },
  "peerDependencies": {
    "node": ">=18.17.0"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "packageManager": "npm@10.8.2",
  "preferGlobal": true,
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "browserslist": [
    "node >= 18.17.0"
  ],
  "volta": {
    "node": "18.20.4"
  }
}
