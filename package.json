{
  "name": "svger-cli",
  "version": "4.0.9",
  "description": "Enterprise-grade SVG to component converter with advanced plugin system, visual diff testing, and official framework integrations. Supporting React, React Native, Vue, Angular, Svelte, Solid, Lit, Preact & Vanilla. Features TypeScript, HMR, optimization pipeline, and extensible architecture.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "svger-cli": "bin/svg-tool.js",
    "svger": "bin/svg-tool.js",
    "test-svger": "bin/test-svger.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./webpack": {
      "types": "./dist/integrations/webpack.d.ts",
      "import": "./dist/integrations/webpack.js",
      "default": "./dist/integrations/webpack.js"
    },
    "./webpack-loader": {
      "types": "./dist/integrations/webpack.d.ts",
      "import": "./dist/integrations/webpack.js",
      "default": "./dist/integrations/webpack.js"
    },
    "./vite": {
      "types": "./dist/integrations/vite.d.ts",
      "import": "./dist/integrations/vite.js",
      "default": "./dist/integrations/vite.js"
    },
    "./rollup": {
      "types": "./dist/integrations/rollup.d.ts",
      "import": "./dist/integrations/rollup.js",
      "default": "./dist/integrations/rollup.js"
    },
    "./babel": {
      "types": "./dist/integrations/babel.d.ts",
      "import": "./dist/integrations/babel.js",
      "default": "./dist/integrations/babel.js"
    },
    "./babel-plugin": {
      "types": "./dist/integrations/babel.d.ts",
      "import": "./dist/integrations/babel.js",
      "default": "./dist/integrations/babel.js"
    },
    "./nextjs": {
      "types": "./dist/integrations/nextjs.d.ts",
      "import": "./dist/integrations/nextjs.js",
      "default": "./dist/integrations/nextjs.js"
    },
    "./jest": {
      "types": "./dist/integrations/jest-preset.d.ts",
      "import": "./dist/integrations/jest-preset.js",
      "default": "./dist/integrations/jest-preset.js"
    },
    "./jest-transformer": {
      "types": "./dist/integrations/jest-preset.d.ts",
      "import": "./dist/integrations/jest-preset.js",
      "default": "./dist/integrations/jest-preset.js"
    },
    "./jest-preset": {
      "types": "./dist/integrations/jest-preset.d.ts",
      "import": "./dist/integrations/jest-preset.js",
      "default": "./dist/integrations/jest-preset.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "bin/svg-tool.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "DEVELOPMENT.md",
    "docs/ADR-*.md",
    "docs/ERROR-HANDLING-STANDARD.md",
    "docs/FRAMEWORK-GUIDE.md",
    "docs/INTEGRATIONS.md",
    "docs/MIGRATION-*.md",
    "docs/OPTIONAL-DEPENDENCIES.md",
    "docs/performance/*.md",
    "docs/phase0-*.md",
    "docs/PIPELINE-INTEGRATION.md",
    "docs/PLUGIN-DEVELOPMENT-GUIDE.md",
    "docs/QUICK-REFERENCE.md",
    "docs/SAMPLE-SVGS-TESTING.md",
    "docs/TDR-*.md",
    "examples/**/*.js",
    ".svgerconfig.example.json",
    "assets/svges/**/*.svg"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "dev": "ts-node --esm src/cli.ts",
    "test": "npm run test:frameworks && npm run test:config && npm run test:e2e && npm run test:integrations",
    "test:jest": "jest --passWithNoTests",
    "test:unit": "jest --testPathPattern='src/__tests__' --passWithNoTests",
    "test:frameworks": "node tests/unit/frameworks.test.js",
    "test:config": "tsc tests/config-options.test.ts --outDir dist-tests --module es2022 --target es2022 --moduleResolution bundler && node dist-tests/config-options.test.js",
    "test:e2e": "tsc tests/e2e-complete.test.ts --outDir dist-tests --module es2022 --target es2022 --moduleResolution bundler && node dist-tests/e2e-complete.test.js",
    "test:integrations": "node tests/integrations/verify-integrations.mjs",
    "test:characterization": "node tests/phase0/dual-path-characterization.mjs",
    "test:security": "node tests/phase0/security-containment.test.mjs",
    "test:safety-matrix": "node tests/phase0/entrypoint-safety-matrix.test.mjs",
    "test:package": "npm run build && node tests/phase0/package-smoke.test.mjs",
    "test:phase0": "npm run build && npm run test:characterization && npm run test:security && npm run test:safety-matrix",
    "test:phase1:contracts": "npm run build && node tests/phase1/report-contract.test.mjs",
    "test:phase1:planning": "npm run build && node tests/phase1/planning-contract.test.mjs",
    "test:phase1:application": "npm run build && node tests/phase1/application-service.contract.test.mjs",
    "test:phase1:entrypoints": "npm run build && node tests/phase1/unified-entrypoints.contract.test.mjs",
    "test:phase1:cache": "npm run build && node tests/phase1/cache.contract.test.mjs",
    "test:phase1:recovery": "npm run build && node tests/phase1/recovery.contract.test.mjs",
    "test:phase1:migration": "npm run build && node tests/phase1/migration.contract.test.mjs",
    "test:phase1:commands": "npm run build && node tests/phase1/command-hierarchy.contract.test.mjs",
    "test:visual": "node tests/dev/test-visual-diff.js",
    "test:visual:integration": "node tests/dev/test-visual-integration.js",
    "test:visual:ci": "node tests/dev/test-visual-integration.js --strict",
    "test:visual:update": "UPDATE_SNAPSHOTS=1 node tests/dev/test-visual-diff.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:all": "npm run test:jest && npm run test:frameworks && npm run test:config && npm run test:e2e",
    "prepublishOnly": "npm run build",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:budget": "node scripts/check-lint-budget.mjs",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "prepack": "npm run build",
    "release": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish",
    "docs:generate": "typedoc --out docs/api src/index.ts",
    "benchmark": "node --loader ts-node/esm scripts/benchmark.ts",
    "baseline:verify": "node scripts/verify-baseline.mjs",
    "baseline:policy": "node scripts/check-baseline-change-policy.mjs",
    "baseline:update": "node scripts/update-baseline.mjs",
    "package:conformance": "node scripts/archive-package-conformance.mjs",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "validate:phase0": "npm run baseline:policy && npm run typecheck && npm run lint:budget && npm run build && npm run test:jest && npm run test && npm run test:phase0 && npm run test:package"
  },
  "keywords": [
    "svg",
    "react",
    "vue",
    "angular",
    "svelte",
    "solid",
    "preact",
    "lit",
    "cli",
    "components",
    "typescript",
    "zero-dependency",
    "performance",
    "design-system",
    "responsive",
    "enterprise",
    "batch-processing",
    "icon-generation",
    "frontend-tooling",
    "webpack",
    "webpack-plugin",
    "webpack-loader",
    "vite",
    "vite-plugin",
    "rollup",
    "rollup-plugin",
    "babel",
    "babel-plugin",
    "babel-transform",
    "nextjs",
    "next-js",
    "jest",
    "jest-preset",
    "jest-transformer",
    "build-tools",
    "bundler",
    "hmr",
    "hot-module-replacement",
    "web-components",
    "component-library",
    "svg-optimization",
    "framework-agnostic",
    "developer-tools",
    "build-tools"
  ],
  "author": {
    "name": "Faeze Mohades",
